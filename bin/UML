QUESTÃO 4
public String aString; → Verdadeiro (acessível por subclasse)
protected boolean aBoolean; → Verdadeiro (acessível por subclasse)
int anInt; → Falso (se subclasse estiver em pacote diferente; só acessa se mesmo pacote)
private double aDouble; → Falso (não acessível)
public String aMethod() → Verdadeiro (acessível)
private class aNestedClass → Falso (não acessível)
public aClassConstructor() → Verdadeiro (subclasse pode chamar com super())

